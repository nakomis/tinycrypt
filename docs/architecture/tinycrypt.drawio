<mxCell id="publish" value="&lt;b&gt;publish-ota.sh x.y.z&lt;/b&gt;&lt;br&gt;clean tree, new version,&lt;br&gt;signed=true + sha256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="solo1" value="&lt;b&gt;solo1 CTAP2 / U2F core&lt;/b&gt;&lt;br&gt;(submodule; tc_* wrappers hash&lt;br&gt;the exact request, read rpId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="presence" value="&lt;b&gt;port/presence.c&lt;/b&gt;&lt;br&gt;arms button + watch + push;&lt;br&gt;first to approve wins; bound to&lt;br&gt;the request hash (fails closed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="240" height="90" as="geometry"/></mxCell>
