<mxCell id="atecc" value="ATECC608 secure element (CRYPT-22)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;fontSize=11;fontColor=#4d7a3a;" vertex="1" parent="1"><mxGeometry x="630" y="185" width="200" height="40" as="geometry"/></mxCell>
<mxCell id="notifier" value="&lt;b&gt;notifier.c&lt;/b&gt;&lt;br&gt;Wi-Fi + esp-mqtt over TLS,&lt;br&gt;the key&#x27;s own X.509 cert&lt;br&gt;(one push per user action)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="250" width="250" height="80" as="geometry"/></mxCell>
