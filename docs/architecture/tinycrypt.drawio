<mxCell id="provision" value="&lt;b&gt;provision-key.sh&lt;/b&gt;&lt;br&gt;Thing + X.509 cert&lt;br&gt;→ prov.bin (Wi-Fi from SSM,&lt;br&gt;endpoint, cert, key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="build" value="&lt;b&gt;build.sh → sign.sh&lt;/b&gt;&lt;br&gt;RSA-3072, key from Keychain&lt;br&gt;(master in SSM); checked&lt;br&gt;against {env}.pub.pem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="180" height="90" as="geometry"/></mxCell>
