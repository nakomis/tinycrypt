// CRYPT-27: CI's distribution signing for the TestFlight archive, layered over the XcodeGen project
// (xcodebuild -xcconfig). Manual signing with CI's own Apple Distribution certificate and the two
// App Store profiles (made through the API, fetched by name in CI): the iPhone app and the watch app
// are told apart by SDK. Local builds keep automatic signing.
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = 62YFUFBSFX
CODE_SIGN_IDENTITY = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*] = tinycrypt CI iOS App Store
PROVISIONING_PROFILE_SPECIFIER[sdk=watchos*] = tinycrypt CI watch App Store
