CONFIG_IDF_TARGET="esp32s3"

# One HID interface (FIDO), no CDC: the native USB port is the security key.
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_ENABLED=n

# Crashes are saved to flash (read with: idf.py coredump-info), since the
# native USB port is the key and there may be no UART console attached.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# 1 ms ticks: the port's short waits (pdMS_TO_TICKS(1..5)) are 0 at 100 Hz.
CONFIG_FREERTOS_HZ=1000

# Notifier (CRYPT-15): drop an unsent presence request after 10 s, so a reconnect can't deliver
# a prompt for a CTAP request that has already timed out.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=10000

# Watch presence over BLE (CRYPT-13): NimBLE, peripheral only. The verify runs in the host task,
# which needs more than the default stack for an ECDSA P-256 verification.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
