CONFIG_IDF_TARGET="esp32s3"

# One HID interface (FIDO), no CDC: the native USB port is the security key.
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_ENABLED=n

# Crashes are saved to flash (read with: idf.py coredump-info), since the
# native USB port is the key and there may be no UART console attached.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# 1 ms ticks: the port's short waits (pdMS_TO_TICKS(1..5)) are 0 at 100 Hz.
CONFIG_FREERTOS_HZ=1000

# Notifier (CRYPT-15): drop an unsent presence request after 10 s, so a reconnect can't deliver
# a prompt for a CTAP request that has already timed out.
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=10000

# Watch presence over BLE (CRYPT-13): NimBLE, peripheral only. The verify runs in the host task,
# which needs more than the default stack for an ECDSA P-256 verification.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
# Bonding with the enrolled watch (CRYPT-19): LE Secure Connections only, bonds kept in NVS.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_MAX_BONDS=2

# OTA (CRYPT-14): two app slots, and a new image that fails its self-test (or crashes before passing
# it) is rolled back by the bootloader. Images must be signed (RSA-3072, the secure boot v2 scheme);
# an update is checked against the key that signed the running app. Signing happens outside the
# build (sign.sh), with the key from the Keychain. Without secure boot this protects updates, not a
# USB cable: that's the eFuse work.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
