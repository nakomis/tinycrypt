# The secured variant (CRYPT-34): sdkconfig.defaults plus secure boot v2, flash encryption in release
# mode and NVS encryption. Prod keys and the sandbox canary run it; the sandbox dev boards run the plain
# build and never burn an eFuse. App and bootloader are built together with these settings, as ESP-IDF
# expects. The bootloader turns secure boot and flash encryption on at its first boot and burns:
#   secure boot: the digests of every key that signed it (sign.sh: the env's key and its backup)
#   flash encryption: an XTS-AES-256 key it generates itself (never leaves the chip)
#   release mode: JTAG off, ROM download only in secure download mode (no reads), no manual encrypt
# NVS: the default partition is encrypted with keys derived from an HMAC key the app generates into
# eFuse block 5 on first boot. prov stays plain (nvs_flash_init_partition), written by the host.
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT is not set
# CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT is not set
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_BOOT_V2_RSA_ENABLED=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES256=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=y
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5
# The secured bootloader is 40 KB, so the partition table moves to 0xC000 (partitions-secured.csv).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-secured.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000
