# The provisioner image (CRYPT-22, build.sh provisioner): no radio, no USB key, just the secure
# element and the console, on the native USB port (USB-Serial-JTAG).
CONFIG_TINYCRYPT_PROVISIONER=y
CONFIG_TINYCRYPT_NOTIFIER=n
CONFIG_TINYCRYPT_WATCH_BLE=n
CONFIG_TINYCRYPT_LED=n
CONFIG_BT_ENABLED=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
