(footprint "DebugPads_1x4_P2.54" (layer "F.Cu")
  (descr "Four SMD test pads on 2.54 mm pitch for a pogo clip or a soldered header; no paste")
  (attr smd exclude_from_pos_files exclude_from_bom)
  (fp_text reference "TP**" (at 0 -5) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "DEBUG" (at 0 5) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_rect (start -0.6 -4.71) (end 0.6 4.71) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (pad "1" smd rect (at 0 -3.81) (size 1 1.6) (layers "F.Cu" "F.Mask"))
  (pad "2" smd rect (at 0 -1.27) (size 1 1.6) (layers "F.Cu" "F.Mask"))
  (pad "3" smd rect (at 0 1.27) (size 1 1.6) (layers "F.Cu" "F.Mask"))
  (pad "4" smd rect (at 0 3.81) (size 1 1.6) (layers "F.Cu" "F.Mask"))
)
