(footprint "MountingHole_M2_2.2mm_Pad4.4" (layer "F.Cu")
  (descr "M2 mounting hole: 2.2 mm plated drill, 4.4 mm GND pad ring that doubles as the copper keep-out")
  (attr exclude_from_pos_files exclude_from_bom)
  (fp_text reference "H**" (at 0 -3) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "M2" (at 0 3) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_circle (center 0 0) (end 2.45 0) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_circle (center 0 0) (end 2.45 0) (stroke (width 0.05) (type solid)) (fill none) (layer "B.CrtYd"))
  (pad "1" thru_hole circle (at 0 0) (size 4.4 4.4) (drill 2.2) (layers "*.Cu" "*.Mask"))
)
